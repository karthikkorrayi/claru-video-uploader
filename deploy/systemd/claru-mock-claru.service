[Unit]
Description=Mock Claru for the test server (NOT the real service)
After=network-online.target

[Service]
Type=simple
User=claru
Group=claru
WorkingDirectory=/opt/claru/current
EnvironmentFile=/etc/claru/claru.env
# Submissions survive restarts (every deploy restarts the mock): /var/lib/claru-mock, created by systemd.
StateDirectory=claru-mock
Environment=MOCK_CLARU_STATE_FILE=/var/lib/claru-mock/state.json
ExecStart=/opt/claru/current/node_modules/.bin/tsx mocks/src/claru-server.ts
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
SyslogIdentifier=claru-mock-claru

[Install]
WantedBy=multi-user.target
