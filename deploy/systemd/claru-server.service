[Unit]
Description=Claru Video Uploader (API, background jobs)
After=network-online.target postgresql.service claru-mock-claru.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=claru
Group=claru
WorkingDirectory=/opt/claru/current
EnvironmentFile=/etc/claru/claru.env
ExecStart=/opt/claru/current/node_modules/.bin/tsx server/src/index.ts
Restart=always
RestartSec=3
# The server finishes in-flight requests on SIGTERM; uploads resume by themselves afterwards.
KillSignal=SIGTERM
TimeoutStopSec=20
# Hardening: read-only system, writable data folder only.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/claru
SyslogIdentifier=claru-server

[Install]
WantedBy=multi-user.target
