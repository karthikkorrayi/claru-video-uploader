[Unit]
Description=Mock Microsoft Graph for the test server (NOT the real service)
After=network-online.target

[Service]
Type=simple
User=claru
Group=claru
WorkingDirectory=/opt/claru/current
EnvironmentFile=/etc/claru/claru.env
ExecStart=/opt/claru/current/node_modules/.bin/tsx mocks/src/graph-server.ts
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
SyslogIdentifier=claru-mock-graph

[Install]
WantedBy=multi-user.target
