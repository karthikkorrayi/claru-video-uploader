# Copy to .env (the L0 script does this and fills in the secrets). Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# PostgreSQL (Homebrew, localhost only)
DATABASE_URL=postgresql://localhost:5432/claru_dev
TEST_DATABASE_URL=postgresql://localhost:5432/claru_test

# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=

# Sign-in sessions (L1). Defaults shown; remove a line to use the default.
SESSION_HOURS=12
# auto = Secure cookies only in production (HTTPS); yes / no to force
COOKIE_SECURE=auto
# no locally; loopback in production behind Caddy
TRUST_PROXY=no

# Holding area for uploads in transit (absolute paths, outside the repo, same disk)
WORK_DIR=
TUS_DIR=

# Uploads (L2). Defaults shown.
# Largest file accepted, in GB (your recordings are 2-4 GB).
MAX_UPLOAD_GB=8
# Free space always kept on the disk, in GB. An upload needs 2 x its size + this.
DISK_RESERVE_GB=10
# An upload with no new data for this many hours is given up and its partial file deleted.
UPLOAD_ABANDON_HOURS=72

# Checks and clips (L3). Must match Claru's project (GET /supplier/projects);
# the server logs a warning at start if they differ.
CLARU_PROJECT_ID=92070f8b-acfb-44c2-8e73-1e6d9918a2b6
CLIP_MIN_SECONDS=300
CLIP_MAX_SECONDS=1800
# 4_3 or 16_9: the project's picture shape; the other one is accepted with a warning
CAPTURE_ASPECT=4_3
# ffmpeg / ffprobe commands (Homebrew puts them on PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Claru review (L4): alert when Claru has not decided this many hours after sealing,
# then remind every REVIEW_REMINDER_HOURS. Decimals allowed for testing (0.1 = 6 minutes).
REVIEW_ALERT_HOURS=72
REVIEW_REMINDER_HOURS=6
# How often to ask Claru for verdicts, in minutes ("every few minutes, not every few seconds").
CLARU_POLL_MINUTES=3

# Mock Claru behaviour (local and test server only)
# Seconds a sealed clip stays "processing" before "in review".
MOCK_CLARU_PROCESSING_SECONDS=20
# 0 = clips wait in review until you approve or reject them (Claru page / Details).
MOCK_CLARU_AUTO_APPROVE_SECONDS=0

# Banner shown in the web app, e.g. on the test server. Empty locally.
ENVIRONMENT_LABEL=

# Claru: the local MOCK during development. Real Claru is used only in the
# controlled test (phase L7); pointing at app.claru.ai outside production
# also needs ALLOW_REAL_CLARU=yes, so it cannot happen by accident.
CLARU_BASE_URL=http://127.0.0.1:4010/api/v1
CLARU_API_KEY=mock-claru-key
CLARU_CONTRACT_VERSION=2
ALLOW_REAL_CLARU=no

# Mock servers
MOCK_CLARU_PORT=4010
MOCK_CLARU_KEY=mock-claru-key
MOCK_GRAPH_PORT=4020

# Microsoft Graph (OneDrive): the local mock until phase L5
GRAPH_BASE_URL=http://127.0.0.1:4020/v1.0
# 32 random bytes, base64: openssl rand -base64 32 (encrypts OneDrive tokens later)
TOKEN_ENC_KEY=
